rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // isAdmin is a pure role check. The only place a hardcoded email grants
    // anything is isBootstrapAdminEmail(), used once to let the founder
    // account claim role:'admin' on its own /users doc (see /users update).
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isBootstrapAdminEmail() {
      return isAuthenticated() &&
        request.auth.token.email.lower() in ["dieudonneishara@gmail.com", "citovictoire2@gmail.com"];
    }

    function isCoopManager(coopId) {
      return isAuthenticated() && getUserData().role == 'coop_manager' && getUserData().cooperativeId == coopId;
    }

    // Verifies an invited manager's claim server-side: the cooperative they're
    // about to attach to must list their verified auth email as managerEmail.
    function isClaimingInvite() {
      return request.resource.data.cooperativeId is string &&
        exists(/databases/$(database)/documents/cooperatives/$(request.resource.data.cooperativeId)) &&
        get(/databases/$(database)/documents/cooperatives/$(request.resource.data.cooperativeId)).data.managerEmail == request.auth.token.email;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCooperative(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.country is string && data.country.size() > 0 &&
             data.members is int && data.members >= 0;
    }

    function isValidStaging(data) {
      return data.keys().hasAll(['data', 'status', 'uploadedBy', 'createdAt']) &&
             data.data is map &&
             data.data.name is string && data.data.name.size() > 0 &&
             data.status == 'pending';
    }

    function isValidUser(data) {
      return data.email is string && 
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() < 100)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() < 20)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() < 500));
    }

    // EUDR readiness summary — admin-written only (see /cooperatives rules).
    // computedAt/sourceFileHash/etc. come from the tools/eudr script output;
    // the badge is only trustworthy if coop_managers can never write this map.
    function isValidEudrCompliance(data) {
      return data.keys().hasAll(['scorePercent', 'totalFarms', 'farmsWithGps',
               'oversizedFarmsMissingPolygon', 'computedAt',
               'sourceFileHash', 'sourceFileName', 'scriptVersion']) &&
             data.keys().hasOnly(['scorePercent', 'totalFarms', 'farmsWithGps',
               'oversizedFarmsMissingPolygon', 'computedAt',
               'sourceFileHash', 'sourceFileName', 'scriptVersion']) &&
             data.scorePercent is number && data.scorePercent >= 0 && data.scorePercent <= 100 &&
             data.totalFarms is int && data.totalFarms >= 0 &&
             data.farmsWithGps is int && data.farmsWithGps >= 0 &&
             data.farmsWithGps <= data.totalFarms &&
             data.oversizedFarmsMissingPolygon is bool &&
             data.computedAt is string && data.computedAt.size() <= 40 &&
             data.sourceFileHash is string && data.sourceFileHash.size() == 64 &&
             data.sourceFileName is string && data.sourceFileName.size() <= 200 &&
             data.scriptVersion is string && data.scriptVersion.size() <= 40;
    }

    function isValidBestOfCongoEdition(data) {
      return data.year is number && data.year >= 2000 && data.year <= 2100 &&
             (!('theme' in data) || (data.theme is string && data.theme.size() <= 500));
    }

    function isValidEditionParticipant(data) {
      return data.coopId is string && data.coopId.size() > 0 &&
             data.qtySubmitted is number && data.qtySubmitted >= 0 &&
             data.cuppingScore is number && data.cuppingScore >= 0 && data.cuppingScore <= 100 &&
             (!('rank' in data) || (data.rank is number && data.rank >= 0)) &&
             data.sales is list;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Self-created docs are always born as plain 'user' with no cooperativeId,
      // and the email must match the verified auth token (no spoofing). Admins
      // may create docs for other users without those restrictions.
      allow create: if isAdmin() ||
        (isOwner(userId) && isValidUser(request.resource.data) &&
         request.resource.data.role == 'user' &&
         request.resource.data.email == request.auth.token.email &&
         !('cooperativeId' in request.resource.data));

      allow update: if
        // Admins can edit any user doc, but the result must still be valid.
        (isAdmin() && isValidUser(request.resource.data)) ||
        // Owners can edit their own profile fields, but never role or email.
        (isOwner(userId) && isValidUser(request.resource.data) &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.email == resource.data.email) ||
        // One-time bootstrap: the founder account claims role 'admin' on itself.
        (isOwner(userId) && isBootstrapAdminEmail() &&
         resource.data.role != 'admin' &&
         request.resource.data.role == 'admin' &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
         isValidUser(request.resource.data)) ||
        // Invite claim: an invited manager attaches the cooperative that named
        // their verified email, verified server-side via isClaimingInvite().
        (isOwner(userId) && resource.data.role == 'user' && !('cooperativeId' in resource.data) &&
         request.resource.data.role == 'coop_manager' &&
         request.resource.data.email == resource.data.email &&
         isClaimingInvite() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'cooperativeId']) &&
         isValidUser(request.resource.data));
    }

    match /cooperatives/{coopId} {
      allow read: if true;
      // eudrCompliance is admin-only on BOTH paths. Guarding update alone is not
      // enough: a coop_manager can also create this doc (delete-recreate or
      // pre-assigned cooperativeId), so create must reject the key outright.
      allow create: if isValidCooperative(request.resource.data) && (
        (isAdmin() &&
         (!('eudrCompliance' in request.resource.data) ||
          isValidEudrCompliance(request.resource.data.eudrCompliance))) ||
        (isCoopManager(coopId) &&
         !('eudrCompliance' in request.resource.data))
      );
      // Managers may still edit every other field; only a CHANGE to
      // eudrCompliance is blocked (diff().affectedKeys() ignores fields
      // resubmitted with identical values, so full-doc saves keep working).
      allow update: if isValidCooperative(request.resource.data) && (
        (isAdmin() &&
         (!('eudrCompliance' in request.resource.data) ||
          isValidEudrCompliance(request.resource.data.eudrCompliance))) ||
        (isCoopManager(coopId) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['eudrCompliance']))
      );
      allow delete: if isAdmin();
    }

    // Buyer sample requests (RequestSampleModal). Buyers are not signed in,
    // so create is public — but shape-locked and size-bounded so the open
    // endpoint can't be used to store arbitrary data. Read/manage is admin-only.
    match /leads/{leadId} {
      allow create: if
        request.resource.data.keys().hasOnly(['coopId', 'coopName', 'buyerName',
          'company', 'country', 'interest', 'quantityKg', 'message',
          'createdAt', 'status']) &&
        request.resource.data.keys().hasAll(['coopId', 'coopName', 'buyerName',
          'company', 'country', 'interest', 'createdAt', 'status']) &&
        request.resource.data.status == 'new' &&
        request.resource.data.interest in ['sample', 'contract', 'info'] &&
        request.resource.data.coopId is string && request.resource.data.coopId.size() <= 128 &&
        request.resource.data.coopName is string && request.resource.data.coopName.size() <= 200 &&
        request.resource.data.buyerName is string && request.resource.data.buyerName.size() >= 1 &&
        request.resource.data.buyerName.size() <= 100 &&
        request.resource.data.company is string && request.resource.data.company.size() >= 1 &&
        request.resource.data.company.size() <= 200 &&
        request.resource.data.country is string && request.resource.data.country.size() >= 1 &&
        request.resource.data.country.size() <= 100 &&
        (!('quantityKg' in request.resource.data) ||
         (request.resource.data.quantityKg is string && request.resource.data.quantityKg.size() <= 50)) &&
        (!('message' in request.resource.data) ||
         (request.resource.data.message is string && request.resource.data.message.size() <= 1000));
      allow read, update, delete: if isAdmin();
    }

    match /staging_cooperatives/{stagingId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidStaging(request.resource.data) &&
                       request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /bestofcongo_editions/{year} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBestOfCongoEdition(request.resource.data) && isValidId(year);
      allow delete: if isAdmin();
    }

    match /bestofcongo_editions/{year}/participants/{coopId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidEditionParticipant(request.resource.data) && isValidId(year) && isValidId(coopId);
      allow delete: if isAdmin();
    }

    // Collection group rule for participants (used in Best of Congo history)
    match /{path=**}/participants/{participantId} {
      allow read: if true;
    }
  }
}
